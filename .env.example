# ===========================================================
#  DW Stack - ตัวอย่างไฟล์ environment
#  คัดลอกเป็น .env ก่อนรัน:  copy .env.example .env
#  แล้วแก้ค่ารหัสผ่าน/คีย์ทุกตัวให้เป็นของตัวเอง
# ===========================================================

# ---------- PostgreSQL (warehouse + metadata ของทุกบริการ) ----------
POSTGRES_USER=dw_user
POSTGRES_PASSWORD=dw_password_change_me
# database หลักที่ใช้เป็น Data Warehouse
POSTGRES_DB=dw
# database สำหรับ metadata ของ Airflow
AIRFLOW_DB=airflow
# database สำหรับ application data ของ Metabase
METABASE_DB=metabase
# schema 3 ชั้นของ warehouse ที่จะถูกสร้างตอน init ครั้งแรก (คั่นด้วยช่องว่าง)
DW_SCHEMAS=raw staging marts
# port ที่ map ออกมาบนเครื่อง host
POSTGRES_PORT=5432

# ---------- Airflow ----------
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.11
AIRFLOW_WEBSERVER_PORT=8080
# uid ของ process ใน container (บน Windows/Docker Desktop ปล่อย 50000 ได้เลย)
AIRFLOW_UID=50000

# บัญชี admin ของ Airflow UI
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_change_me
AIRFLOW_ADMIN_FIRSTNAME=Data
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# คีย์ลับ - สร้างใหม่ก่อนใช้งานจริง
#   Fernet key : docker run --rm apache/airflow:2.10.5-python3.11 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Secret key : python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_FERNET_KEY=gW-tofugPm2Q9FhydhWIw0HhBoDQ54chlkqcKrzzLyQ=
AIRFLOW_SECRET_KEY=change_me_to_a_long_random_hex_string

# timezone ที่แสดงใน Airflow UI
AIRFLOW_TIMEZONE=Asia/Bangkok

# ---------- Metabase ----------
METABASE_PORT=3000

# ---------- pgAdmin ----------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_change_me
# จำนวนครั้งที่ใส่รหัสผิดได้ก่อนบัญชี pgAdmin ถูกล็อก (0 = ไม่ล็อกเลย)
PGADMIN_MAX_LOGIN_ATTEMPTS=0
